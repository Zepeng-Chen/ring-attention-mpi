#!/bin/bash
# Resource and queue requests are passed to qsub after checking the site.
# Run this inside a compute allocation; no compilation on Vanda login nodes.
set -euo pipefail
: "${PBS_JOBID:?run through PBS in a compute allocation}"
cd "${PBS_O_WORKDIR:?submit this script from the frozen source directory}"
evidence_dir="$(cd .. && pwd)/evidence"
mkdir -p "$evidence_dir"
exec > "$evidence_dir/probe.out" 2> "$evidence_dir/probe.err"
trap 'status=$?; printf "%s\n" "$status" > "$evidence_dir/exit-status.txt"' EXIT

date -u '+%Y-%m-%dT%H:%M:%SZ'
hostname
uname -a
printf 'PBS_JOBID=%s\n' "${PBS_JOBID:-unavailable}"
printf 'PBS_NP=%s\n' "${PBS_NP:-unavailable}"
if [[ -n "${PBS_NODEFILE:-}" && -f "$PBS_NODEFILE" ]]; then
    cp "$PBS_NODEFILE" "$evidence_dir/nodes.txt"
    sort "$PBS_NODEFILE" | uniq -c
fi

# Add only module commands verified on the target system to environment.sh.
if [[ -f scripts/hpc/environment.sh ]]; then
    source scripts/hpc/environment.sh
fi
if type module >/dev/null 2>&1; then module list 2>&1; fi
for tool in cmake c++ mpicxx mpirun nvcc nvidia-smi ncu nsys; do
    command -v "$tool" || true
done
if command -v lscpu >/dev/null 2>&1; then lscpu; fi
if command -v mpirun >/dev/null 2>&1; then mpirun --version; fi
if command -v nvcc >/dev/null 2>&1; then nvcc --version; fi
if command -v nvidia-smi >/dev/null 2>&1; then nvidia-smi -L; fi
if command -v cmake >/dev/null 2>&1; then cmake --version; fi
